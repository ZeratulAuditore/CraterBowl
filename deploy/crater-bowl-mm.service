# systemd unit for a VPS without Docker: copy the Linux build to /opt/crater/, then
#   sudo cp deploy/crater-bowl-mm.service /etc/systemd/system/ && sudo systemctl enable --now crater-bowl-mm
# Open UDP 24600 in the firewall/security group.
[Unit]
Description=Crater Bowl matchmaker
After=network-online.target

[Service]
User=crater
ExecStart=/opt/crater/CraterBowl.x86_64 --headless -- --matchmaker --port=24600
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
